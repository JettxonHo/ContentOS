# Local development state-service configuration. Copy to .env and replace every placeholder.
POSTGRES_USER=contentos_local_user
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
POSTGRES_DB=contentos_local
POSTGRES_PORT=5432

REDIS_PASSWORD=replace-with-a-local-redis-password
REDIS_PORT=6379

OBJECT_STORAGE_ACCESS_KEY=replace-with-a-local-access-key
OBJECT_STORAGE_SECRET_KEY=replace-with-a-local-secret-key
OBJECT_STORAGE_PORT=8333

# API object-storage runtime. Secret keys stay in the variables above and are
# injected into ApiSecrets; the values below are non-secret runtime configuration.
CONTENTOS_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:8333
CONTENTOS_OBJECT_STORAGE_REGION=us-east-1
CONTENTOS_OBJECT_STORAGE_BUCKET=contentos-local
CONTENTOS_OBJECT_STORAGE_FORCE_PATH_STYLE=true

# API runtime. DATABASE_URL is a Secret and must use the same local PostgreSQL
# values above. Generate the password hash with `corepack pnpm auth:hash-password`.
CONTENTOS_ENV=development
API_HOST=127.0.0.1
API_PORT=3001
CONTENTOS_WEB_ORIGIN=http://127.0.0.1:3000
CONTENTOS_OWNER_USER_ID=replace-with-an-opaque-uuid
CONTENTOS_OWNER_PASSWORD_HASH=replace-with-a-scrypt-hash
CONTENTOS_SESSION_TTL_SECONDS=86400
CONTENTOS_SECURE_COOKIES=false
DATABASE_URL=postgresql://contentos_local_user:replace-with-a-local-postgres-password@127.0.0.1:5432/contentos_local

# Private Fetcher Gateway service identity. Keep the real value outside Git and
# inject the same URL-safe base64url token into API and Fetcher only.
CONTENTOS_FETCHER_GATEWAY_SECRET=replace-with-a-url-safe-base64url-secret
CONTENTOS_FETCHER_GATEWAY_API_ORIGIN=http://127.0.0.1:3001

# Public Web runtime configuration. This value is sent to the browser; it must
# contain no Secret. Local development accepts only an IPv4-loopback origin.
CONTENTOS_API_ORIGIN=http://127.0.0.1:3001
