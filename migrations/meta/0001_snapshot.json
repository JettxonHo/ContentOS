        "content_packages_title_length_check": {
          "name": "content_packages_title_length_check",
          "value": "char_length(\"content_packages\".\"title\") BETWEEN 1 AND 200"
        },
        "content_packages_description_length_check": {
          "name": "content_packages_description_length_check",
          "value": "\"content_packages\".\"description\" IS NULL OR char_length(\"content_packages\".\"description\") <= 2000"
        },
        "content_packages_mode_check": {
          "name": "content_packages_mode_check",
          "value": "\"content_packages\".\"content_mode\" IN ('deferred', 'creator_led', 'research_based')"
        },
        "content_packages_requested_output_check": {
          "name": "content_packages_requested_output_check",
          "value": "\"content_packages\".\"requested_blog\" OR \"content_packages\".\"requested_xiaohongshu\""
        },
        "content_packages_lifecycle_check": {
          "name": "content_packages_lifecycle_check",
          "value": "\"content_packages\".\"lifecycle\" IN ('active', 'archived')"
        },
        "content_packages_revision_check": {
          "name": "content_packages_revision_check",
          "value": "\"content_packages\".\"revision\" >= 1"
        },
        "content_packages_archive_state_check": {
          "name": "content_packages_archive_state_check",
          "value": "(\"content_packages\".\"lifecycle\" = 'active' AND \"content_packages\".\"archived_at\" IS NULL) OR (\"content_packages\".\"lifecycle\" = 'archived' AND \"content_packages\".\"archived_at\" IS NOT NULL)"
