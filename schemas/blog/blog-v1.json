{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contentos.local/schemas/blog/blog-v1.json",
  "title": "ContentOS Blog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "summary", "markdown", "contentMode", "publicReferences", "internalProvenance"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 200, "pattern": "^[^\\u0000\\uD800-\\uDFFF]+$" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1000, "pattern": "^[^\\u0000\\uD800-\\uDFFF]+$" },
    "markdown": { "type": "string", "minLength": 1, "maxLength": 50000, "pattern": "^[^\\u0000\\uD800-\\uDFFF]+$" },
    "contentMode": { "enum": ["creator_led", "research_based"] },
    "publicReferences": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["label", "sourceVersionId"],
        "properties": {
          "label": { "type": "string", "minLength": 1, "maxLength": 200 },
          "sourceVersionId": { "type": "string", "format": "uuid" }
        }
      }
    },
    "internalProvenance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["researchItemId", "sourceVersionIds", "opinionVersionId"],
        "properties": {
          "researchItemId": { "type": "string", "minLength": 1, "maxLength": 100 },
          "sourceVersionIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": { "type": "string", "format": "uuid" }
          },
          "opinionVersionId": { "anyOf": [{ "type": "string", "format": "uuid" }, { "type": "null" }] }
        }
      }
    }
  }
}
