{
  "name": "contentos",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=24.18.0 <25.0.0",
    "pnpm": "11.17.0"
  },
  "scripts": {
    "typecheck": "corepack pnpm -r --workspace-concurrency=1 run typecheck",
    "build": "corepack pnpm --filter @contentos/web --filter @contentos/api --filter @contentos/worker --filter @contentos/fetcher --filter @contentos/renderer -r --workspace-concurrency=1 run build",
    "workspace:check": "corepack pnpm --filter @contentos/web --filter @contentos/api --filter @contentos/worker --filter @contentos/fetcher --filter @contentos/renderer --filter @contentos/core --filter @contentos/contracts --filter @contentos/config --filter @contentos/testing --fail-if-no-match exec node --version",
    "start:web": "corepack pnpm --filter @contentos/web start",
    "start:api": "corepack pnpm --filter @contentos/api start",
    "start:worker": "corepack pnpm --filter @contentos/worker start",
    "start:fetcher": "corepack pnpm --filter @contentos/fetcher start",
    "start:renderer": "corepack pnpm --filter @contentos/renderer start",
    "infra:config": "docker compose config",
    "infra:pull": "docker compose pull",
    "infra:up": "docker compose up --detach --wait",
    "infra:status": "docker compose ps",
    "infra:logs": "docker compose logs --tail=200",
    "infra:down": "docker compose down"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3"
  }
}
